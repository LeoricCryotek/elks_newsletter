<odoo>
    <record id="view_newsletter_archive_list" model="ir.ui.view"><field name="name">Newsletter archive</field><field name="model">elks.newsletter.archive</field><field name="arch" type="xml"><list><field name="issue_month"/><field name="name"/><field name="website_id"/><field name="published"/></list></field></record>
    <record id="view_newsletter_archive_form" model="ir.ui.view"><field name="name">Newsletter archive form</field><field name="model">elks.newsletter.archive</field><field name="arch" type="xml"><form><header><button name="action_publish" type="object" string="Publish" class="oe_highlight" invisible="published"/><button name="action_unpublish" type="object" string="Unpublish" invisible="not published"/><field name="published" invisible="1"/></header><sheet><group><field name="name"/><field name="issue_month"/><field name="website_id"/><field name="pdf" filename="filename"/><field name="filename" invisible="1"/><field name="issue_id" invisible="not issue_id"/></group><p>Upload a previous newsletter PDF and select its month and year. Publish makes it available to everyone on the selected website.</p></sheet></form></field></record>
    <record id="action_newsletter_archive" model="ir.actions.act_window"><field name="name">Website Newsletter Archive</field><field name="res_model">elks.newsletter.archive</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_newsletter_archive" name="Website Archive / Import PDFs" parent="menu_elks_newsletter_root" action="action_newsletter_archive" sequence="30"/>
    <record id="view_issue_publish_website" model="ir.ui.view"><field name="name">Newsletter website publishing</field><field name="model">elks.newsletter.issue</field><field name="inherit_id" ref="view_elks_newsletter_issue_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><field name="marketing_mailing_id" invisible="1"/><button name="action_refresh_marketing_email" type="object" string="Rebuild Marketing Email" invisible="not marketing_mailing_id" confirm="Replace the draft email body with fresh excerpts from this newsletter? Recipients and sender settings will stay unchanged."/><button name="action_open_marketing_email" type="object" string="Marketing Email" invisible="not marketing_mailing_id"/><button name="action_publish_website" type="object" string="Publish to Website" class="oe_highlight" invisible="state != 'final'"/></xpath></field></record>
    <record id="archive_company_rule" model="ir.rule"><field name="name">Newsletter archive company access</field><field name="model_id" ref="model_elks_newsletter_archive"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="view_newsletter_website_appearance" model="ir.ui.view">
        <field name="name">Newsletter website appearance</field><field name="model">website</field>
        <field name="arch" type="xml"><form string="Newsletter Page Appearance" create="0" delete="0"><sheet><group><field name="name" readonly="1"/><field name="newsletter_banner_title"/><field name="newsletter_banner_subtitle"/><field name="newsletter_banner_image" widget="image"/></group><p>Use a wide landscape photo. The banner crops the edges to fill the screen; keep important subjects near the center. Clear the photo to use the purple background.</p></sheet></form></field>
    </record>
    <record id="action_newsletter_website_appearance" model="ir.actions.act_window"><field name="name">Newsletter Page Appearance</field><field name="res_model">website</field><field name="view_mode">list,form</field><field name="domain">[('company_id', 'in', context.get('allowed_company_ids', []))]</field></record>
    <record id="view_newsletter_website_list" model="ir.ui.view"><field name="name">Newsletter websites</field><field name="model">website</field><field name="arch" type="xml"><list create="0" delete="0"><field name="name"/><field name="newsletter_banner_title"/><field name="company_id"/></list></field></record>
    <record id="action_newsletter_appearance_list" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_newsletter_website_list"/><field name="act_window_id" ref="action_newsletter_website_appearance"/></record>
    <record id="action_newsletter_appearance_form" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_newsletter_website_appearance"/><field name="act_window_id" ref="action_newsletter_website_appearance"/></record>
    <menuitem id="menu_newsletter_website_appearance" name="Website Banner" parent="menu_elks_newsletter_root" action="action_newsletter_website_appearance" sequence="40" groups="website.group_website_designer"/>
    <template id="newsletter_archive_page" name="Newsletter Depot">
        <t t-call="website.layout"><div id="wrap" class="elks-newsletter-depot">
            <section class="newsletter-hero">
                <img t-if="newsletter_website.newsletter_banner_image" t-att-src="image_data_uri(newsletter_website.newsletter_banner_image)" class="newsletter-hero-photo" alt=""/>
                <div class="container newsletter-hero-content"><span class="newsletter-eyebrow">ELKS CARE — ELKS SHARE</span><h1 t-esc="newsletter_website.newsletter_banner_title or 'Newsletter Depot'"/><p t-esc="newsletter_website.newsletter_banner_subtitle or 'Lodge news. Shared service. Community spirit.'"/><a t-if="releases" href="#newsletter-editions" class="btn btn-light">Explore the latest issue <span aria-hidden="true">↓</span></a></div>
            </section>
            <section class="container py-5" id="newsletter-editions">
                <div class="newsletter-section-heading"><div><span class="newsletter-eyebrow">FROM YOUR LODGE</span><h2>Stay in the loop</h2></div><p>Printed copies are available in the Lobby.</p></div>
                <div t-if="not releases" class="newsletter-empty"><h3>Our next edition is on its way</h3><p>Published newsletters will appear here. Check back for lodge news and upcoming events.</p></div>
                <div class="newsletter-editions-grid"><t t-foreach="releases" t-as="release">
                    <article t-att-class="'newsletter-edition newsletter-featured' if release_first else 'newsletter-edition'">
                        <div class="newsletter-edition-art" aria-hidden="true"><span>ELKS</span><strong>NEWS<br/>LETTER</strong><span t-field="release.issue_month" t-options="{'widget':'date','format':'MMMM yyyy'}"/></div>
                        <div class="newsletter-edition-body"><span class="newsletter-eyebrow" t-esc="'LATEST EDITION' if release_first else 'FROM THE ARCHIVE'"/><h3 t-field="release.issue_month" t-options="{'widget':'date','format':'MMMM yyyy'}"/><p t-esc="release.name"/><div class="newsletter-edition-actions"><a class="btn btn-primary" t-att-href="'/elks/newsletters/%s/pdf' % release.id" target="_blank" rel="noopener">Read newsletter <span aria-hidden="true">↗</span></a><a class="btn btn-outline-primary" t-att-href="'/elks/newsletters/%s/pdf?download=1' % release.id">Download PDF</a></div></div>
                    </article>
                </t></div>
            </section>
        </div></t>
    </template>
</odoo>
